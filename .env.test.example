NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nhtsa_test
LOG_LEVEL=warn
NHTSA_ALL_MAKES_URL=https://example.com/getallmakes
NHTSA_VEHICLE_TYPES_BASE_URL=https://example.com/GetVehicleTypesForMakeId/{makeId}
NHTSA_REQUEST_TIMEOUT_MS=5000
NHTSA_MAX_RETRIES=0
NHTSA_RETRY_BASE_DELAY_MS=10
NHTSA_BREAKER_FAILURE_THRESHOLD=5
NHTSA_BREAKER_RESET_MS=30000
INGESTION_CONCURRENCY=2
INGESTION_BATCH_SIZE=25
INGESTION_REQUEST_DELAY_MS=0
INGESTION_MAX_MAKES=0
INGESTION_TRANSACTION_TIMEOUT_MS=10000
INGEST_ON_STARTUP=false
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nhtsa_test
